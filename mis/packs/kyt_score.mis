  invariant kyt_score_019: kyt_score_019_bound == true;
  invariant kyt_score_020: kyt_score_020_bound == true;

  outcome assert_pack(payload: Bytes) {
    require payload != @0;
    constraint pack_bound == true;
  }

  outcome settle_clrty1(intent: Bytes) {
    require intent != @0;
    constraint chain_id == 1202;
  }

  outcome assert_kyt_score_001(payload: Bytes) {
    require payload != @0;
    constraint kyt_score_001_bound == true;
    constraint chain_id == 1202;
  }

