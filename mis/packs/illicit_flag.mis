// Moniversive Invariant Static (MIS) — deep root
// Creator: Chandler William Ferguson
// Letter-hash + EMBED gates 3..=6 · settlement clrty-1 / chain 1202
// Compile: bin/misc <file>.mis --check --compact-letters
// Title: Chainalysis KYT Screener · IllicitFlag

module ChainalysisKytScreenerIllicitFlag {

  invariant letter_hash_bound: letter_hash_root != @0;
  invariant deep_root_moniversive: deep_root == moniversive;
  invariant settlement_chain: chain_id == 1202;
  invariant settlement_network_clrty1: settlement_network == clrty_1;
  invariant kernel_is_misc: compiler_kernel == misc;
  invariant pack_illicit_flag_bound: pack_bound == true;
  invariant catalog_backlink: mis_catalog_bound == true;

  invariant illicit_flag_021: illicit_flag_021_bound == true;
  invariant illicit_flag_022: illicit_flag_022_bound == true;
  invariant illicit_flag_023: illicit_flag_023_bound == true;
  invariant illicit_flag_024: illicit_flag_024_bound == true;
  invariant illicit_flag_025: illicit_flag_025_bound == true;
  invariant illicit_flag_026: illicit_flag_026_bound == true;
  invariant illicit_flag_027: illicit_flag_027_bound == true;
  invariant illicit_flag_028: illicit_flag_028_bound == true;
  invariant illicit_flag_029: illicit_flag_029_bound == true;
  invariant illicit_flag_030: illicit_flag_030_bound == true;
  invariant illicit_flag_031: illicit_flag_031_bound == true;
  invariant illicit_flag_032: illicit_flag_032_bound == true;
  invariant illicit_flag_033: illicit_flag_033_bound == true;
  invariant illicit_flag_034: illicit_flag_034_bound == true;
  invariant illicit_flag_035: illicit_flag_035_bound == true;
  invariant illicit_flag_036: illicit_flag_036_bound == true;
  invariant illicit_flag_037: illicit_flag_037_bound == true;
