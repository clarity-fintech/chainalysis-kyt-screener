  invariant illicit_flag_039: illicit_flag_039_bound == true;
  invariant illicit_flag_040: illicit_flag_040_bound == true;

  outcome assert_pack(payload: Bytes) {
    require payload != @0;
    constraint pack_bound == true;
  }

  outcome settle_clrty1(intent: Bytes) {
    require intent != @0;
    constraint chain_id == 1202;
  }

  outcome assert_illicit_flag_021(payload: Bytes) {
    require payload != @0;
    constraint illicit_flag_021_bound == true;
    constraint chain_id == 1202;
  }

