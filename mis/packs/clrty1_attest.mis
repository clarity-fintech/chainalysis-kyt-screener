  invariant clrty1_attest_098: clrty1_attest_098_bound == true;
  invariant clrty1_attest_099: clrty1_attest_099_bound == true;
  invariant clrty1_attest_100: clrty1_attest_100_bound == true;

  outcome assert_pack(payload: Bytes) {
    require payload != @0;
    constraint pack_bound == true;
  }

  outcome settle_clrty1(intent: Bytes) {
    require intent != @0;
    constraint chain_id == 1202;
  }

  outcome assert_clrty1_attest_081(payload: Bytes) {
