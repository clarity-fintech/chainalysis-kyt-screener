    constraint kyt_score_006_bound == true;
    constraint chain_id == 1202;
  }

  outcome assert_kyt_score_007(payload: Bytes) {
    require payload != @0;
    constraint kyt_score_007_bound == true;
    constraint chain_id == 1202;
  }

