// Moniversive Invariant Static (MIS) — deep root
// Creator: Chandler William Ferguson
// Letter-hash + EMBED gates 3..=6 · settlement clrty-1 / chain 1202
// Compile: bin/misc <file>.mis --check --compact-letters
// Title: Chainalysis KYT Screener · KytScore

module ChainalysisKytScreenerKytScore {

  invariant letter_hash_bound: letter_hash_root != @0;
  invariant deep_root_moniversive: deep_root == moniversive;
  invariant settlement_chain: chain_id == 1202;
  invariant settlement_network_clrty1: settlement_network == clrty_1;
  invariant kernel_is_misc: compiler_kernel == misc;
  invariant pack_kyt_score_bound: pack_bound == true;
  invariant catalog_backlink: mis_catalog_bound == true;

  invariant kyt_score_001: kyt_score_001_bound == true;
  invariant kyt_score_002: kyt_score_002_bound == true;
  invariant kyt_score_003: kyt_score_003_bound == true;
  invariant kyt_score_004: kyt_score_004_bound == true;
  invariant kyt_score_005: kyt_score_005_bound == true;
  invariant kyt_score_006: kyt_score_006_bound == true;
  invariant kyt_score_007: kyt_score_007_bound == true;
  invariant kyt_score_008: kyt_score_008_bound == true;
  invariant kyt_score_009: kyt_score_009_bound == true;
  invariant kyt_score_010: kyt_score_010_bound == true;
  invariant kyt_score_011: kyt_score_011_bound == true;
  invariant kyt_score_012: kyt_score_012_bound == true;
  invariant kyt_score_013: kyt_score_013_bound == true;
  invariant kyt_score_014: kyt_score_014_bound == true;
  invariant kyt_score_015: kyt_score_015_bound == true;
